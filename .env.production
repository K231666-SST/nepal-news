APP_NAME="Nepal News Australia"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nepal-news-australia.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT}
DB_DATABASE=${DB_DATABASE}
DB_USERNAME=${DB_USERNAME}
DB_PASSWORD=${DB_PASSWORD}

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=${MAIL_USERNAME}
MAIL_PASSWORD=${MAIL_PASSWORD}
MAIL_FROM_ADDRESS=noreply@nepalnewsaustralia.com.au
MAIL_FROM_NAME="Nepal News Australia"

OPENWEATHER_API_KEY=${OPENWEATHER_API_KEY}
METAL_PRICE_API_KEY=${METAL_PRICE_API_KEY}
EXCHANGE_RATE_API_KEY=${EXCHANGE_RATE_API_KEY}
